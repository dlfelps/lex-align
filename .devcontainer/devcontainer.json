{
  "name": "Python",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  // Install Node.js so we can install Claude Code via npm
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },

  // Explicitly mount only this folder; prevents parent directory from being visible in the container
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/lex-align,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/lex-align",

  // 1. Install uv + project deps, materialize the quickstart bundle, install Claude Code
  "postCreateCommand": "pip install uv && uv sync && uv run lex-align-server quickstart --no-serve && npm install -g @anthropic-ai/claude-code && mkdir -p ~/.claude && cp -r /tmp/claude-host/. ~/.claude/ && chmod 700 ~/.claude && chmod 600 ~/.claude/.credentials.json 2>/dev/null || true && cp /tmp/claude-host.json ~/.claude.json && chmod 600 ~/.claude.json",

  // 2. On every container start, boot the server in the background on :8765
  "postStartCommand": "uv run lex-align-server quickstart > /tmp/lex-align-server.log 2>&1 &",

  // Forward the server port so it is reachable from the host
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "lex-align server",
      "onAutoForward": "silent"
    }
  },

  "mounts": [
    // Claude credentials — mount read-only to temp path; postCreateCommand copies with correct ownership
    "source=${localEnv:USERPROFILE}/.claude,target=/tmp/claude-host,type=bind,readonly",
    // Claude config file (.claude.json) lives at the home root, not inside .claude/
    "source=${localEnv:USERPROFILE}/.claude.json,target=/tmp/claude-host.json,type=bind,readonly",

    // Workspace is auto-mounted by VS Code at /workspaces/<folder>,
    // so your files persist on the host automatically.
    // Add extra named volumes here if you want to cache pip/venvs:
    // "source=python-venv-cache,target=/home/vscode/.venv,type=volume"
  ],

  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/lex-align/.venv/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
